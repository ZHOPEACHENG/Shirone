# build output
dist/

# integration cache (esbuild config bundles, plugin-mode font subsets)
.shirones/

# content repository working copy, provenance, and safe cleanup backups
.content-src/
.content-backup/
content.lock.json
Shirone-Content/

# content repository (materialized by `pnpm content:sync`; the content repo owns these)
/src/content/
/src/data/*.ts
/src/user/user-config.ts
/src/config/FooterConfig.html
/src/assets/images/
/public/images/
/public/assets/anime/*.webp
/public/assets/audio/
/public/assets/music/
/public/assets/projects/
/public/logo/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

.vercel

package-lock.json
bun.lockb
yarn.lock

# ide
.idea

# fonts: 原件由内容仓提供（内容仓 assets/fonts/ → 本仓 src/assets/fonts/），
# 子集字体是构建期生成物。整个目录都归内容仓管，故整目录忽略。
/src/assets/fonts/

# generated local icon collection
src/generated/local-icon-collections.ts
*.iml

# anime snapshot data & downloaded covers
src/data/anime-snapshots/*.json
public/assets/anime/covers/*
!public/assets/anime/covers/.gitkeep

# generated responsive moment thumbnails
public/assets/moments/thumbnails/*
!public/assets/moments/thumbnails/.gitkeep

# local tooling artifacts
.zcode/
.codex-*.log
research/

# playwright
.playwright-cli/
test-results/
playwright-report/
tests/site/visual.spec.ts-snapshots/

# Lighthouse local reports
artifacts/lighthouse/*
!artifacts/lighthouse/.gitkeep
.lighthouseci/

# generated AI skills plugin packages
artifacts/shirone-ai-*
